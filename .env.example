# docker compose 配置模板：复制为 .env 并填入真实值（.env 不提交）
# 启动：docker compose up -d --build
DB_PASSWORD=
# PostgreSQL 密码（引擎的会话状态 + 对话元数据；库里对象由容器首次启动时自动创建）
PG_PASSWORD=
DASHSCOPE_API_KEY=
# JWT 签名密钥（后端登录态用它签名）。必填——不设的话 docker compose 会拒绝启动。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：换掉它会让所有已登录用户需要重新登录
JWT_SECRET=
# LLM 模型名（可选，不填则用 docker-compose.yml 里的默认值）
# 换模型：改这行 → docker compose up -d（重建容器即可，无需重新 build 镜像）
LLM_MODEL_NAME=openai:qwen3.8-2.4t-a95b
