# 环境变量模板（此文件提交到 Git，不含真实密钥）
# 复制此文件为 .env 并填入你的真实密钥

# 阿里云 DashScope API Key
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# PostgreSQL 连接串（本地开发用；库要先在本地 PG 里建好：CREATE DATABASE rag_engine;）
# Docker 部署时不用配这项 —— 由 docker-compose.yml 注入容器内服务名 postgres
POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/rag_engine
